{
  "name": "geodam",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "geodam", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "vars": {
    // "raw" = IP en clair (demandé) ; "hash" = HMAC de l'IP (recommandé RGPD, permet quand même l'anti-abus)
    "IP_MODE": "raw"
  }
}
